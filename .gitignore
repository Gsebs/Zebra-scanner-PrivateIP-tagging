# Real credentials -- never commit
config.json

# Termux APKs are downloaded per-machine, not committed
vendor/*.apk

# Optional local copy of Android Platform Tools (for users who don't want
# to edit their system PATH). Not committed because it's large and
# downloaded per-machine.
platform-tools/

# Local logs pulled from scanners during deployment
bootstrap.log
*.log

# Python
__pycache__/
*.pyc

# OS junk
.DS_Store
Thumbs.db